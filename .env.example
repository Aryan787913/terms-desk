# Copy to .env (never commit .env)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Merchant's annual cost of capital used by the Skeptic (example only)
COST_OF_CAPITAL=0.36
DISCOUNT=0.02
WINDOW_DAYS=10
P_SHIFT=0.5
